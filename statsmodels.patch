+def _validate_penalty(penalty):
+    values = np.asarray(penalty, dtype=float)
+    if values.ndim == 0:
+        values = np.repeat(values, 2)
+    if values.shape != (2,) or not np.isfinite(values).all() or np.any(values < 0):
+        raise ValueError("penalty must contain two finite nonnegative values")
+    return tuple(float(value) for value in values)
+
+
+def _validate_views(exog, endog, min_rows):
+    x, y = np.asarray(exog, dtype=float), np.asarray(endog, dtype=float)
+    if x.ndim != 2 or y.ndim != 2 or not x.shape[1] or not y.shape[1]:
+        raise ValueError("Views must be nonempty two-dimensional arrays")
+    if len(x) != len(y) or len(x) < min_rows:
+        raise ValueError(f"Views need matching rows and at least {min_rows} observations")
+    if not np.isfinite(x).all() or not np.isfinite(y).all():
+        raise ValueError("Views must contain only finite values")
+    return x, y
+
+
+def _paired_correlations(x, y):
+    xc, yc = x - x.mean(0), y - y.mean(0)
+    denominator = np.linalg.norm(xc, axis=0) * np.linalg.norm(yc, axis=0)
+    if len(x) < 2 or np.any(denominator == 0):
+        raise ValueError("Correlation requires at least two nonconstant score observations")
+    return np.clip(np.sum(xc * yc, axis=0) / denominator, -1, 1)
+
+
