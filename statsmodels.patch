+def select_cancorr_penalty(endog, exog, penalty_grid, cv=5, standardize=False, rng=None):
+    """Select ridge penalties by K-fold held-out canonical correlation.
+
+    Parameters
+    ----------
+    endog, exog : array_like
+        Complete, finite paired training views. No external test data are
+        accepted. Centering, scaling and covariance penalties are estimated
+        separately on each fold's training observations.
+    penalty_grid : sequence of pair of float
+        Candidate (exog, endog) trace-relative penalties.
+    cv : int, optional
+        Number of shuffled folds. The default is 5. Each validation fold must
+        contain at least two rows and each training fold at least three.
+    standardize : bool, optional
+        Standardize within each training fold. The default is False.
+    rng : int, array_like of int, numpy.random.Generator, or numpy.random.RandomState, optional
+        Entropy for shuffling rows. The global NumPy state is not used.
+
+    Returns
+    -------
+    Bunch
+        ``model`` is a CanCorr refit on all supplied training data; ``penalty``
+        is the selected pair; ``penalties`` contains the candidates;
+        ``cv_scores`` and ``mean_scores`` contain signed first-component
+        validation correlations. ``folds`` contains training/validation index
+        pairs, and ``failures`` records inapplicable candidate/fold fits.
+
+    Notes
+    -----
+    A candidate failing any fold is excluded, with a NaN mean score. If all
+    candidates fail, a ValueError is raised. Scores equal within 1e-12 prefer
+    the larger total penalty. Fold scores are averaged without aligning or
+    concatenating canonical scores across folds. This helper selects
+    penalties; it does not produce a p-value or an unbiased performance
+    estimate for the selected model. Evaluate that model on separate data.
+    """
+    x, y = _validate_views(exog, endog, min_rows=3)
+    nobs = len(x)
+    if (isinstance(cv, (bool, np.bool_)) or not isinstance(cv, (int, np.integer))
+            or cv < 2 or nobs // cv < 2 or nobs - int(np.ceil(nobs / cv)) < 3):
+        raise ValueError("cv must provide at least two validation and three training rows per fold")
+    penalties = [_validate_penalty(pair) for pair in penalty_grid]
+    if not penalties:
+        raise ValueError("penalty_grid must contain at least one candidate")
+    if not isinstance(standardize, (bool, np.bool_)):
+        raise ValueError("standardize must be a boolean")
+    generator = rng if isinstance(rng, np.random.RandomState) else np.random.default_rng(rng)
+    parts = np.array_split(generator.permutation(nobs), cv)
+    folds = [(np.concatenate(parts[:j] + parts[j + 1:]), part)
+             for j, part in enumerate(parts)]
+    scores = np.full((len(penalties), cv), np.nan)
+    failures = []
+    for i, penalty in enumerate(penalties):
+        for j, (train, validation) in enumerate(folds):
+            try:
+                model = CanCorr(y[train], x[train], penalty=penalty,
+                                standardize=standardize)
+                u, v = model.transform(x[validation], y[validation])
+                scores[i, j] = _paired_correlations(u[:, :1], v[:, :1])[0]
+            except ValueError as exc:
+                failures.append({"candidate": i, "fold": j, "reason": str(exc)})
+    means = scores.mean(1)
+    eligible = np.flatnonzero(np.isfinite(means))
+    if not len(eligible):
+        raise ValueError("No penalty candidate could be evaluated on every fold")
+    best = eligible[0]
+    for i in eligible[1:]:
+        tied = np.isclose(means[i], means[best], rtol=1e-12, atol=1e-12)
+        if (means[i] > means[best] and not tied) or (tied and sum(penalties[i]) > sum(penalties[best])):
+            best = i
+    model = CanCorr(y, x, penalty=penalties[best], standardize=standardize)
+    return Bunch(model=model, penalty=penalties[best], penalties=penalties,
+                 cv_scores=scores, mean_scores=means, folds=folds, failures=failures)
+
+
