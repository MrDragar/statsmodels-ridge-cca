diff --git a/statsmodels/multivariate/tests/test_cancorr_cv.py b/statsmodels/multivariate/tests/test_cancorr_cv.py
new file mode 100644
index 000000000..f24053239
--- /dev/null
+++ b/statsmodels/multivariate/tests/test_cancorr_cv.py
@@ -0,0 +1,89 @@
+import numpy as np
+from numpy.testing import assert_allclose, assert_array_equal
+import pytest
+
+from statsmodels.multivariate.cancorr import CanCorr
+
+
+def select(*args, **kwargs):
+    from statsmodels.multivariate.cancorr import select_cancorr_penalty
+    return select_cancorr_penalty(*args, **kwargs)
+
+
+def correlation(model, x, y):
+    u, v = model.transform(x, y)
+    return np.corrcoef(u[:, 0], v[:, 0])[0, 1]
+
+
+def test_cv_matches_train_only_preprocessing_and_manual_fold_scores():
+    rng = np.random.default_rng(93)
+    x = rng.normal(size=(30, 6))
+    y = x[:, :2] @ rng.normal(size=(2, 4)) + rng.normal(size=(30, 4))
+    x[::3] *= 100
+    y[1::3] += 100
+    grid = [(0.1, 1), (1, 0.1), (1, 1)]
+    result = select(y, x, grid, cv=3, standardize=True, rng=72)
+    expected = np.empty((len(grid), 3))
+    for i, penalty in enumerate(grid):
+        for j, (train, validation) in enumerate(result.folds):
+            model = CanCorr(y[train], x[train], penalty=penalty, standardize=True)
+            expected[i, j] = correlation(model, x[validation], y[validation])
+    assert_allclose(result.cv_scores, expected, atol=1e-12)
+    assert_allclose(result.mean_scores, expected.mean(1), atol=1e-12)
+    assert result.penalty == grid[np.argmax(expected.mean(1))]
+    assert_allclose(result.model.x_mean, x.mean(0))
+    assert_allclose(result.model.y_mean, y.mean(0))
+    # Standardizing before splitting would change the fitted directions here.
+    train, validation = result.folds[0]
+    x_global, y_global = x / x.std(0, ddof=1), y / y.std(0, ddof=1)
+    leaked = CanCorr(y_global[train], x_global[train], penalty=grid[0])
+    leaked_score = correlation(leaked, x_global[validation], y_global[validation])
+    assert abs(leaked_score - expected[0, 0]) > 1e-6
+
+
+def test_cv_keeps_negative_validation_correlations():
+    x = np.random.default_rng(8).normal(size=(30, 3))
+    y = x[:, :1].copy()
+    first_validation = np.random.default_rng(31).permutation(len(x))[:10]
+    y[first_validation] *= -1
+    result = select(y, x, [(1, 1)], cv=3, rng=31)
+    assert result.cv_scores[0, 0] < -0.9
+
+
+def test_cv_ties_prefer_larger_total_penalty():
+    x = np.arange(30.)[:, None]
+    result = select(x, x, [(0.1, 0.1), (10, 1)], cv=3, rng=2)
+    assert result.penalty == (10, 1)
+
+
+def test_cv_reproducibility_without_modifying_global_rng():
+    x = np.random.default_rng(9).normal(size=(30, 3))
+    y = np.random.default_rng(10).normal(size=(30, 2))
+    state = np.random.get_state()[1].copy()
+    a = select(y, x, [(0.1, 1), (1, 1)], cv=3, rng=14)
+    b = select(y, x, [(0.1, 1), (1, 1)], cv=3, rng=14)
+    assert_array_equal(a.cv_scores, b.cv_scores)
+    assert_array_equal(np.random.get_state()[1], state)
+    validation_rows = np.concatenate([test for _, test in a.folds])
+    assert_array_equal(np.sort(validation_rows), np.arange(len(x)))
+    for train, test in a.folds:
+        assert len(np.intersect1d(train, test)) == 0
+
+
+def test_inapplicable_zero_penalty_is_recorded_and_not_selected():
+    x = np.random.default_rng(1).normal(size=(18, 25))
+    y = np.random.default_rng(2).normal(size=(18, 20))
+    result = select(y, x, [(0, 0), (1, 1)], cv=3, rng=1)
+    assert result.penalty == (1, 1)
+    assert np.isnan(result.mean_scores[0])
+    assert len(result.failures) == 3
+    with pytest.raises(ValueError, match=r"candidate|penalt"):
+        select(y, x, [(0, 0)], cv=3, rng=1)
+
+
+@pytest.mark.parametrize("grid,cv", [([], 3), ([(1, -1)], 3), ([(1, 1)], 1),
+                                    ([(1, 1)], 11), ([(1, 1)], 1.5)])
+def test_invalid_cv_configuration(grid, cv):
+    x = np.random.default_rng(1).normal(size=(20, 3))
+    with pytest.raises(ValueError):
+        select(x, x, grid, cv=cv, rng=1)
diff --git a/statsmodels/multivariate/tests/test_cancorr_ridge.py b/statsmodels/multivariate/tests/test_cancorr_ridge.py
new file mode 100644
index 000000000..28e69cf60
--- /dev/null
+++ b/statsmodels/multivariate/tests/test_cancorr_ridge.py
@@ -0,0 +1,99 @@
+"""Ridge extension of CanCorr, including independent R reference values."""
+
+from pathlib import Path
+
+import numpy as np
+from numpy.testing import assert_allclose, assert_array_equal
+import pandas as pd
+import pytest
+
+from statsmodels.multivariate.cancorr import CanCorr
+
+
+def paired_data(n=45, p=7, q=5):
+    rng = np.random.default_rng(148)
+    x = rng.normal(size=(n, p))
+    y = x[:, :2] @ rng.normal(size=(2, q)) + rng.normal(size=(n, q))
+    return x, y
+
+
+def test_explicit_zero_penalty_preserves_classical_outputs():
+    x, y = paired_data()
+    old = CanCorr(y, x)
+    zero = CanCorr(y, x, penalty=(0, 0))
+    assert_array_equal(zero.cancorr, old.cancorr)
+    assert_array_equal(zero.x_cancoef, old.x_cancoef)
+    assert_array_equal(zero.y_cancoef, old.y_cancoef)
+    pd.testing.assert_frame_equal(zero.corr_test().stats, old.corr_test().stats)
+    u, _ = zero.transform(x, y)
+    assert_allclose(u.T @ u, np.eye(len(zero.cancorr)), atol=1e-12)
+
+
+@pytest.mark.parametrize("case,penalty", [
+    ("classical", (0, 0)), ("ridge_lowdim", (0.3, 1.2)), ("ridge_wide", (0.3, 1.2)),
+])
+def test_ridge_matches_independent_r_reference(case, penalty):
+    fixture = Path(__file__).parent / "results/ridge_cca" / case
+    x = np.loadtxt(fixture / "x.csv", delimiter=",")
+    y = np.loadtxt(fixture / "y.csv", delimiter=",")
+    ref = np.loadtxt(fixture / "r_results.csv", delimiter=",", skiprows=1)
+    model = CanCorr(y, x, penalty=penalty)
+    assert_allclose(model.penalized_roots[:3], ref[:, 0], atol=1e-8, rtol=1e-6)
+    assert_allclose(model.cancorr[:3], ref[:, 1], atol=1e-8, rtol=1e-6)
+    for view, coefs in [("x", model.x_cancoef), ("y", model.y_cancoef)]:
+        expected = np.loadtxt(fixture / f"r_{view}_weights.csv", delimiter=",")
+        q1 = np.linalg.qr(coefs[:, :3], mode="reduced")[0]
+        q2 = np.linalg.qr(expected, mode="reduced")[0]
+        assert_allclose(np.linalg.svd(q1.T @ q2, compute_uv=False), np.ones(3), atol=1e-8)
+
+
+def test_penalized_gram_constraints_and_separate_score_correlations():
+    x, y = paired_data(n=18, p=32, q=25)
+    model = CanCorr(y, x, penalty=(0.3, 1.2))
+    xc, yc = x - x.mean(0), y - y.mean(0)
+    gx = xc.T @ xc + (len(x) - 1) * model.lambda_x * np.eye(x.shape[1])
+    gy = yc.T @ yc + (len(y) - 1) * model.lambda_y * np.eye(y.shape[1])
+    k = len(model.cancorr)
+    assert_allclose(model.x_cancoef.T @ gx @ model.x_cancoef, np.eye(k), atol=1e-10)
+    assert_allclose(model.y_cancoef.T @ gy @ model.y_cancoef, np.eye(k), atol=1e-10)
+    assert np.max(abs(model.cancorr - model.penalized_roots)) > 0.01
+
+
+def test_transform_uses_training_preprocessing_and_accepts_one_row():
+    x, y = paired_data()
+    model = CanCorr(y, x, penalty=(0.1, 1), standardize=True)
+    u, v = model.transform(x[:1] + 100, y[:1] - 100)
+    assert_allclose(u, (x[:1] + 100 - model.x_mean) @ model.x_cancoef)
+    assert_allclose(v, (y[:1] - 100 - model.y_mean) @ model.y_cancoef)
+    assert_allclose(model.x_mean, x.mean(0))
+    assert_allclose(model.y_mean, y.mean(0))
+
+
+def test_negative_heldout_correlation_is_preserved():
+    x = np.arange(8.)[:, None]
+    model = CanCorr(x, x, penalty=1)
+    u, v = model.transform(x, -x)
+    assert_allclose(np.corrcoef(u[:, 0], v[:, 0])[0, 1], -1, atol=1e-12)
+
+
+def test_legacy_f_test_is_not_available_for_ridge():
+    x, y = paired_data()
+    model = CanCorr(y, x, penalty=(1, 0))
+    with pytest.raises(NotImplementedError, match=r"regulariz|penal"):
+        model.corr_test()
+
+
+def test_only_the_unpenalized_view_requires_full_column_rank():
+    x, y = paired_data()
